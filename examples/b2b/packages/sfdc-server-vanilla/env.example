# Salesforce Integration Server Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# DOCKER IMAGE CONFIGURATION
# =============================================================================

# GitHub Container Registry image (defaults to ghcr.io/${GITHUB_OWNER}/sfdc-server-vanilla:latest)
# IMPORTANT: Set GITHUB_OWNER to the repository owner (organization name or username), not your personal username
# This should match the owner of the GitHub repository where images are pushed
# Set SFDC_SERVER_IMAGE to override the full image path, or set GITHUB_OWNER to use default format
GITHUB_OWNER=repository-owner-or-org-name
# SFDC_SERVER_IMAGE=ghcr.io/repository-owner-or-org-name/sfdc-server-vanilla:latest

# =============================================================================
# SALESFORCE CONFIGURATION (Required)
# =============================================================================

# Salesforce Connected App Consumer Key (Client ID)
# Get this from your Salesforce Connected App settings
SALESFORCE_CONSUMER_KEY=your_consumer_key_here

# Salesforce Username (email address)
# The username for the Salesforce user account
SALESFORCE_USERNAME=your_username@example.com

# Salesforce Login URL (Optional)
# Default: https://login.salesforce.com (Production)
# For Sandbox: https://test.salesforce.com
# For Custom Domain: https://your-domain.my.salesforce.com
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# =============================================================================
# SERVER CONFIGURATION (Optional)
# =============================================================================

# Server Port (Optional)
# Default: 8080
PORT=8080

# Node Environment (Optional)
# Values: development, production, test
NODE_ENV=development


# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Database Configuration
DATABASE_PATH=./database.db

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis Password (Optional, leave blank if none)
REDIS_PASSWORD=

# OAuth Callback URL
OAUTH_REDIRECT_URL=http://localhost:1420/auth/callback

# Authz Service Configuration (Optional)
# URL of the authz-service for challenge generation
# Default: http://authz-service:3000 (for Docker)
# For local development: http://localhost:3000
AUTHZ_SERVICE_URL=http://authz-service:3000

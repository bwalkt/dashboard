{
  "name": "@pzero/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "rvm use 3.1.0 && react-native run-ios",
    "clean:ios": "rm -rf ios/build; rm -rf ios/Pods; rvm use 3.1.0; cd ios; pod install --clean-install && rm -rf ~/Library/Developer/Xcode/DerivedData/*pzero* && cd ..",
    "build:ios": "cd ios && xcodebuild -workspace pzero.xcworkspace -scheme pzero -configuration Release -archivePath build/mobile.xcarchive -destination \"generic/platform=iOS\" archive CODE_SIGN_IDENTITY=\"\" CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO",
    "copy-icons": "node scripts/copy-icons.js",
    "lint:fix": "biome check --write .",
    "start": "react-native start --reset-cache",
    "test": "jest"
  },
  "dependencies": {
    "@babel/runtime": "catalog:",
    "@pzero/shared": "workspace:*",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "catalog:",
    "@react-navigation/drawer": "catalog:",
    "@react-navigation/native": "catalog:",
    "@react-navigation/native-stack": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "p-queue": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-autocomplete-input": "^5.5.6",
    "react-native-biometrics": "catalog:",
    "react-native-ble-plx": "^3.5.0",
    "react-native-confirmation-code-field": "catalog:",
    "react-native-device-info": "catalog:",
    "react-native-dotenv": "catalog:",
    "react-native-geolocation-service": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-get-random-values": "^1.11.0",
    "react-native-mmkv": "catalog:",
    "react-native-network-info": "^5.2.1",
    "react-native-qrcode-svg": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-splash-screen": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-swipe-list-view": "catalog:",
    "react-native-ui-lib": "catalog:",
    "react-native-vision-camera": "catalog:",
    "react-native-worklets": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@react-native-community/cli": "catalog:",
    "@react-native-community/cli-platform-android": "catalog:",
    "@react-native-community/cli-platform-ios": "catalog:",
    "@react-native/babel-preset": "catalog:",
    "@react-native/metro-config": "catalog:",
    "@react-native/typescript-config": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-test-renderer": "catalog:",
    "jest": "catalog:",
    "metro-config": "catalog:",
    "react-test-renderer": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}

# Custom PostgreSQL image with all required extensions
# This image inherits the standard PostgreSQL entrypoint (docker-entrypoint.sh)
# which automatically handles database initialization and creation of POSTGRES_DB
# when the data directory (/var/lib/postgresql/data) is empty on first startup
FROM postgres:18

# Install required dependencies, PostGIS, and build tools
RUN apt-get update && \
    apt-get install -y \
    postgresql-18-postgis-3 \
    postgresql-plpython3-18 \
    build-essential \
    git \
    curl \
    libssl-dev \
    pkg-config \
    postgresql-server-dev-18 \
    cmake \
    ninja-build \
    python3 \
    wget \
    && rm -rf /var/lib/apt/lists/*

# PL/Python3 is installed via apt-get above, no additional build needed


# Install Rust (required for pgx_ulid)
RUN set -eux; \
    ARCH=$(dpkg --print-architecture); \
    case $ARCH in \
        amd64) target=x86_64-unknown-linux-gnu ;; \
        arm64) target=aarch64-unknown-linux-gnu ;; \
        *) echo "Unsupported architecture: $ARCH" && exit 1 ;; \
    esac; \
    base=https://static.rust-lang.org/rustup/dist/${target}; \
    curl -fSL ${base}/rustup-init -o /usr/local/bin/rustup-init; \
    curl -fSL ${base}/rustup-init.sha256 -o /tmp/rustup-init.sha256; \
    (cd /usr/local/bin && sha256sum -c /tmp/rustup-init.sha256); \
    chmod +x /usr/local/bin/rustup-init; \
    /usr/local/bin/rustup-init -y --no-modify-path --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

# Install cargo-pgrx
RUN cargo install --locked cargo-pgrx && \
    cargo pgrx init --pg18 /usr/lib/postgresql/18/bin/pg_config

# Install pgx_ulid extension
RUN git clone https://github.com/pksunkara/pgx_ulid.git /tmp/pgx_ulid && \
    cd /tmp/pgx_ulid && \
    cargo pgrx install --release && \
    cd / && \
    rm -rf /tmp/pgx_ulid

# Copy custom entrypoint script that ensures database exists
COPY docker-entrypoint.sh /usr/local/bin/custom-entrypoint.sh
RUN chmod +x /usr/local/bin/custom-entrypoint.sh

# Override the entrypoint to use our custom script
ENTRYPOINT ["/usr/local/bin/custom-entrypoint.sh"]

# The custom entrypoint script:
# 1. Calls the original PostgreSQL entrypoint (docker-entrypoint.sh)
# 2. Waits for PostgreSQL to be ready
# 3. Ensures the database specified in POSTGRES_DB exists (creates if missing)
# 4. This works even if the volume already has data from a previous run
#
# The original PostgreSQL entrypoint automatically:
# - Initializes the database cluster if /var/lib/postgresql/data is empty
# - Creates the database specified in POSTGRES_DB environment variable (on first init only)
# - Runs scripts from /docker-entrypoint-initdb.d/ (including init-db.sql) on first init only
#
# Note: shared_preload_libraries is configured via docker-compose.yml command
# Note: Volume should be mounted at /var/lib/postgresql/data (not /var/lib/postgresql)

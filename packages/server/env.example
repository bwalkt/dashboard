# Salesforce Integration Server Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# SALESFORCE CONFIGURATION (Required)
# =============================================================================

# Salesforce Connected App Consumer Key (Client ID)
# Get this from your Salesforce Connected App settings
SALESFORCE_CONSUMER_KEY=your_consumer_key_here

# Salesforce Username (email address)
# The username for the Salesforce user account
SALESFORCE_USERNAME=your_username@example.com

# Salesforce Login URL (Optional)
# Default: https://login.salesforce.com (Production)
# For Sandbox: https://test.salesforce.com
# For Custom Domain: https://your-domain.my.salesforce.com
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# =============================================================================
# SERVER CONFIGURATION (Optional)
# =============================================================================

# Server Port (Optional)
# Default: 8080
PORT=8080

# Node Environment (Optional)
# Values: development, production, test
NODE_ENV=development

# =============================================================================
# SALESFORCE ADVANCED CONFIGURATION (Optional)
# =============================================================================

# Salesforce Instance URL (Optional)
# If you want to override the instance URL after authentication
# SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com

# Salesforce Consumer Secret (Optional)
# Only needed if you're implementing OAuth flow
# SALESFORCE_CONSUMER_SECRET=your_consumer_secret_here

# Salesforce Password (Optional)
# Only needed if you're using username/password authentication
# SALESFORCE_PASSWORD=your_password_here

# Salesforce Security Token (Optional)
# Required if IP restrictions are enabled on your Salesforce org
# SALESFORCE_SECURITY_TOKEN=your_security_token_here

# =============================================================================
# LOGGING CONFIGURATION (Optional)
# =============================================================================

# Log Level (Optional)
# Values: error, warn, info, debug, trace
LOG_LEVEL=info

# =============================================================================
# CORS CONFIGURATION (Optional)
# =============================================================================

# Allowed Origins (Optional)
# Comma-separated list of allowed origins for CORS
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. Required Variables:
#    - SALESFORCE_CONSUMER_KEY: Get from Salesforce Connected App
#    - SALESFORCE_USERNAME: Your Salesforce username/email
#
# 2. Salesforce Connected App Setup:
#    - Go to Setup → App Manager → New Connected App
#    - Enable OAuth Settings
#    - Add callback URL: http://localhost:8080/salesforce/callback
#    - Select OAuth scopes: "Access and manage your data (api)"
#
# 3. Security:
#    - Never commit the actual .env file to version control
#    - Keep your credentials secure
#    - Use different credentials for development and production
#
# 4. Sandbox vs Production:
#    - For Sandbox: Use https://test.salesforce.com
#    - For Production: Use https://login.salesforce.com
#
# 5. Troubleshooting:
#    - Check Salesforce Connected App configuration
#    - Verify OAuth scopes are properly set
#    - Ensure IP restrictions allow your server's IP

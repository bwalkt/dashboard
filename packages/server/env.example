# Salesforce Integration Server Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Server Port (Optional, default: 8090)
PORT=8090

# Node Environment (Optional: development, production, test)
NODE_ENV=development

# Server Base URL (for emails and public assets, default: http://localhost:8090)
SERVER_BASE_URL=http://localhost:8090

# Frontend URL (Optional)
FRONTEND_URL=http://localhost:1420

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# GitHub OAuth Configuration (Required)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# JWT Configuration (Required)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pzero

# PostgreSQL Connection Pool Settings (Optional)
# Max clients in pool (default: 20)
POSTGRES_MAX_CLIENTS=20
# Idle Timeout ms (default: 30000)
POSTGRES_IDLE_TIMEOUT=30000
# Connection Timeout ms (default: 2000)
POSTGRES_CONNECTION_TIMEOUT=2000

# Database URL for migrations (auto-constructed from above values)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pzero

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis Connection URL
# Format: redis://[username]:[password]@host:port[/db]
# Examples:
#   - redis://localhost:6379
#   - redis://:password@localhost:6379
#   - redis://username:password@localhost:6379
#   - redis://username:password@localhost:6379/0
REDIS_URL=redis://localhost:6379

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Brevo Email (Required)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=P-Zero

# Email Expiry Minutes (Optional, default: 100)
EMAIL_EXPIRY_MINUTES=100

# =============================================================================
# SMS CONFIGURATION
# =============================================================================
# Twilio SMS (Required)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_API_KEY=SKXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_PHONE_NUMBER=+12345678900
TWILIO_MESSAGE="Your verification code is: {{code}}"

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed Origins (Optional, default: *)
# Example: http://localhost:1420,https://example.com
CORS_ALLOWED_ORIGINS=*

# Allow Credentials (Optional, default: false)
CORS_ALLOW_CREDENTIALS=false

# Exposed Headers (Optional, default: Content-Range,X-Content-Range,X-Test-Eval)
CORS_EXPOSED_HEADERS=Content-Range,X-Content-Range,X-Test-Eval

# Allowed Headers (Optional, see default list)
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,traceparent,x-client-type,x-auth-token,tracestate,X-Custom-Auth,x-grpc-web,x-grpc-web-accept-encoding,X-Custom-Header

# =============================================================================
# PROXY CONFIGURATION
# =============================================================================
# Allowed domains (Optional)
# Example: example.com,api.example.com:8080
ALLOWED_DOMAINS=example.com,api.example.com:8080

# Cookie Domain for proxied responses (Optional; uncomment to set)

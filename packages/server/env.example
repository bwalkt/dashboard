# =============================================================================
# SIGNOZ CONFIGURATION (Optional)
# =============================================================================
# SigNoz API Configuration for observability data queries
# Base URL for the SigNoz API (e.g., http://localhost:3301 or https://your-signoz-instance.com)
SIGNOZ_API_URL=http://localhost:3301

# SigNoz API Key for authentication
# Generate an API key in SigNoz UI: Settings > API Keys (Admin role required)
# The API key will be included in requests as the SIGNOZ-API-KEY header
SIGNOZ_API_KEY=

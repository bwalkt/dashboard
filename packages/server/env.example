# Salesforce Integration Server Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# SERVER CONFIGURATION (Optional)
# =============================================================================

# Server Port (Optional)
# Default: 8090
PORT=8090

# Node Environment (Optional)
# Values: development, production, test
NODE_ENV=development


# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here


# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pzero
# Database URL for migrations (auto-constructed from above values)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pzero

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Brevo Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=P-Zero

# SignalWire SMS Configuration
SIGNALWIRE_PROJECT_ID=your_signalwire_project_id_here
SIGNALWIRE_TOKEN=your_signalwire_token_here
SIGNALWIRE_PHONE_NUMBER=+12345678900


FRONTEND_URL=http://localhost:1420

# Server Base URL (for emails and public assets)
SERVER_BASE_URL=http://localhost:8090

# =============================================================================
# PROXY CONFIGURATION
# =============================================================================

# Proxy Configuration - Comma-separated list of allowed domains
# Examples: example.com, api.example.com:8080, .example.com (wildcard subdomain)
ALLOWED_DOMAINS=example.com,api.example.com:8080

# Cookie Domain - Domain to use for Set-Cookie headers in proxy responses
# If set, all Set-Cookie headers from proxied responses will have their domain overridden
# COOKIE_DOMAIN=proxy.example.com

# Environment (development/production) - affects error message detail
# ENVIRONMENT=development

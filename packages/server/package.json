{
  "name": "@pzero/admin-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:auth": "vitest run test/routes/auth.test.ts",
    "test:sms": "vitest run test/routes/sms.test.ts",
    "test:middleware": "vitest run test/middleware/",
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "build:proto:disabled": "echo 'Protobuf generation disabled - using manual TypeScript interfaces in src/centrifuge/grpc/services/ext-proc.ts'",
    "start": "fastify start dist/index.js --port 8090",
    "dev": "tsx watch src/server.ts",
    "dev:centrifuge": "tsx watch src/centrifuge/app.ts",
    "dev:both": "concurrently \"pnpm run dev\" \"pnpm run dev:centrifuge\"",
    "dev:fastify": "fastify start dist/index.js --watch --port 8090",
    "clean": "rm -rf dist",
    "migrations:up": "node scripts/run-migrations.js",
    "migrations:down": "node scripts/rollback-migrations.js",
    "migrations:rollback": "node scripts/rollback-migrations.js",
    "docker:down": "docker compose down --remove-orphans",
    "docker:up": "docker compose up -d",
    "docker:postgres": "docker compose up -d pzero-postgres"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@abandonware/noble": "1.9.2-26",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/oauth2": "^8.1.2",
    "@fastify/static": "^8.3.0",
    "@getbrevo/brevo": "^3.0.1",
    "@grpc/grpc-js": "^1.14.2",
    "@grpc/proto-loader": "^0.8.0",
    "@pzero/shared": "workspace:*",
    "@react-email/components": "^1.0.1",
    "@react-email/render": "^2.0.0",
    "@react-email/tailwind": "^2.0.1",
    "@types/ws": "^8.18.1",
    "axios": "catalog:",
    "date-fns": "catalog:",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "node-forge": "^1.3.3",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.16.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "superjson": "catalog:",
    "twilio": "^5.10.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.6",
    "@types/react": "catalog:",
    "@types/supertest": "^6.0.3",
    "@vitest/ui": "catalog:",
    "c8": "^10.1.3",
    "concurrently": "^9.2.1",
    "grpc-tools": "^1.13.1",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@pzero/admin-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:auth": "vitest run test/routes/auth.test.ts",
    "test:sms": "vitest run test/routes/sms.test.ts",
    "test:middleware": "vitest run test/middleware/",
    "build": "tsc",
    "build:proto:disabled": "echo 'Protobuf generation disabled - using manual TypeScript interfaces in src/centrifuge/grpc/services/ext-proc.ts'",
    "start": "fastify start dist/index.js --port 8090",
    "dev": "tsx watch src/server.ts",
    "dev:centrifuge": "tsx watch src/centrifuge/app.ts",
    "dev:both": "concurrently \"pnpm run dev\" \"pnpm run dev:centrifuge\"",
    "dev:fastify": "fastify start dist/index.js --watch --port 8090",
    "clean": "rm -rf dist",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create --migration-file-language sql",
    "docker:down": "docker compose down --remove-orphans",
    "docker:up": "docker compose up -d",
    "docker:postgres": "docker compose up -d pzero-postgres"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/oauth2": "^8.1.2",
    "@fastify/static": "^8.3.0",
    "@getbrevo/brevo": "^3.0.1",
    "@grpc/grpc-js": "^1.14.1",
    "@grpc/proto-loader": "^0.8.0",
    "@pzero/shared": "workspace:*",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.0.3",
    "@react-email/tailwind": "^1.0.4",
    "@signalwire/realtime-api": "^4.1.3",
    "@types/ws": "^8.18.1",
    "axios": "^1.12.2",
    "date-fns": "catalog:",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.1",
    "fastify-cli": "^7.4.0",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.3.1",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.13.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "superjson": "catalog:",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/node-pg-migrate": "^2.3.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/supertest": "^6.0.3",
    "@vitest/ui": "^4.0.9",
    "c8": "^10.1.3",
    "concurrently": "^9.2.1",
    "grpc-tools": "^1.13.0",
    "prettier": "catalog:",
    "prettier-plugin-sql": "0.19.2",
    "supertest": "^7.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "catalog:"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-sql"
    ],
    "overrides": [
      {
        "files": [
          "*.sql"
        ],
        "options": {
          "language": "postgresql",
          "keywordCase": "upper",
          "identifierCase": "lower",
          "dataTypeCase": "lower",
          "functionCase": "lower"
        }
      }
    ]
  }
}

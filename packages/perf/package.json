{
  "name": "@pzero/perf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm run build:k6 && pnpm run build:ui && tsc",
    "build:k6": "tsc -p tsconfig.tests.json",
    "build:ui": "vite build --config ui/vite.config.ts",

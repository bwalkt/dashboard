{
  "name": "@pzero/shared",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "genFunction": "node dist/cli/genFunction.js",
    "genFunction:dev": "tsx src/cli/genFunction.ts"
  },
  "dependencies": {
    "browser-tool": "^1.3.3",
    "long": "^5.3.2",
    "mathjs": "^14.8.1",
    "ts-stats": "^1.0.4",
    "ulid": "3.0.1",
    "validator": "^13.15.15",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/validator": "13.15.3",
    "tsx": "^4.7.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json",
    "./*": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./types/*": {
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js"
    },
    "./grid": {
      "import": "./dist/grid/index.js",
      "types": "./dist/grid/index.d.ts"
    },
    "./actor": {
      "import": "./dist/actor/index.js",
      "types": "./dist/actor/index.d.ts"
    },
    "./contact-points": {
      "import": "./dist/contact-points/index.js",
      "types": "./dist/contact-points/index.d.ts"
    },
    "./pzero": {
      "import": "./dist/pzero/index.js",
      "types": "./dist/pzero/index.d.ts"
    },
    "./secure-point": {
      "import": "./dist/secure-point/index.js",
      "types": "./dist/secure-point/index.d.ts"
    },
    "./secure-wallet": {
      "import": "./dist/secure-wallet/index.js",
      "types": "./dist/secure-wallet/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./uuid": {
      "import": "./dist/uuid.js",
      "types": "./dist/uuid.d.ts"
    },
    "./validator": {
      "import": "./dist/validator/index.js",
      "types": "./dist/validator/index.d.ts"
    },
    "./theme": {
      "import": "./dist/theme/index.js",
      "types": "./dist/theme/index.d.ts"
    },
    "./list": {
      "import": "./dist/list/index.js",
      "types": "./dist/list/index.d.ts"
    },
    "./queue": {
      "import": "./dist/queue/index.js",
      "types": "./dist/queue/index.d.ts"
    },
    "./sql": {
      "import": "./dist/sql/index.js",
      "types": "./dist/sql/index.d.ts"
    }
  }
}

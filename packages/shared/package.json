{
  "name": "@pzero/shared",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:mathjs": "ENABLE_MATHJS_TESTS=true vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "genFunction": "node dist/cli/genFunction.js",
    "genFunction:dev": "tsx src/cli/genFunction.ts"
  },
  "dependencies": {
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "browser-tool": "^1.3.3",
    "date-fns": "catalog:",
    "libphonenumber-js": "1.12.31",
    "long": "5.3.2",
    "mathjs": "15.1.0",
    "uuid": "catalog:",
    "validator": "13.15.23",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/validator": "13.15.10",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite": "^7.2.6",
    "vitest": "catalog:"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json",
    "./*": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./types/*": {
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js"
    },
    "./constants": {
      "import": "./dist/constants/index.js",
      "types": "./dist/constants/index.d.ts"
    },
    "./grid": {
      "import": "./dist/grid/index.js",
      "types": "./dist/grid/index.d.ts"
    },
    "./challenge": {
      "import": "./dist/grid/challenge.js",
      "types": "./dist/grid/challenge.d.ts"
    },
    "./actor": {
      "import": "./dist/actor/index.js",
      "types": "./dist/actor/index.d.ts"
    },
    "./contact-points": {
      "import": "./dist/contact-points/index.js",
      "types": "./dist/contact-points/index.d.ts"
    },
    "./pzero": {
      "import": "./dist/pzero/index.js",
      "types": "./dist/pzero/index.d.ts"
    },
    "./secure-point": {
      "import": "./dist/secure-point/index.js",
      "types": "./dist/secure-point/index.d.ts"
    },
    "./secure-wallet": {
      "import": "./dist/secure-wallet/index.js",
      "types": "./dist/secure-wallet/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./mock": {
      "import": "./dist/mock/index.js",
      "types": "./dist/mock/index.d.ts"
    },
    "./uuid": {
      "import": "./dist/uuid.js",
      "types": "./dist/uuid.d.ts"
    },
    "./validator": {
      "import": "./dist/validator/index.js",
      "types": "./dist/validator/index.d.ts"
    },
    "./theme": {
      "import": "./dist/theme/index.js",
      "types": "./dist/theme/index.d.ts"
    },
    "./list": {
      "import": "./dist/list/index.js",
      "types": "./dist/list/index.d.ts"
    },
    "./queue": {
      "import": "./dist/queue/index.js",
      "types": "./dist/queue/index.d.ts"
    },
    "./sql": {
      "import": "./dist/sql/index.js",
      "types": "./dist/sql/index.d.ts"
    },
    "./http": {
      "import": "./dist/http/index.js",
      "types": "./dist/http/index.d.ts"
    },
    "./data-table": {
      "import": "./dist/utils/data-table/index.js",
      "types": "./dist/utils/data-table/index.d.ts"
    },
    "./phone": {
      "import": "./dist/phone/index.js",
      "types": "./dist/phone/index.d.ts"
    },
    "./api": {
      "import": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    },
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.dev.json": "./tsconfig.dev.json",
    "./tsconfig.build.json": "./tsconfig.build.json"
  }
}

# Salesforce Integration Server Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# SALESFORCE CONFIGURATION (Required)
# =============================================================================

# Salesforce Connected App Consumer Key (Client ID)
# Get this from your Salesforce Connected App settings
SALESFORCE_CONSUMER_KEY=your_consumer_key_here

# Salesforce Username (email address)
# The username for the Salesforce user account
SALESFORCE_USERNAME=your_username@example.com

# Salesforce Login URL (Optional)
# Default: https://login.salesforce.com (Production)
# For Sandbox: https://test.salesforce.com
# For Custom Domain: https://your-domain.my.salesforce.com
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# =============================================================================
# SERVER CONFIGURATION (Optional)
# =============================================================================

# Server Port (Optional)
# Default: 8080
PORT=8080

# Node Environment (Optional)
# Values: development, production, test
NODE_ENV=development


# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Database Configuration
DATABASE_PATH=./database.db


# OAuth Callback URL
OAUTH_REDIRECT_URL=http://localhost:1420/auth/callback

# =============================================================================
# OPENZITI CONFIGURATION (Optional)
# =============================================================================

# Enable OpenZiti integration
# Set to 'true' to enable OpenZiti zero-trust networking
OPENZITI_ENABLED=false

# OpenZiti Controller URL
# The URL of your OpenZiti Controller
OPENZITI_CONTROLLER_URL=https://your-controller.example.com:1280

# OpenZiti Identity Configuration
# Path to the OpenZiti identity configuration file
# This file contains the identity credentials for your server
OPENZITI_IDENTITY_PATH=./config/ziti-identity.json

# OpenZiti Service Name
# The name of the service this server will bind to in OpenZiti
OPENZITI_SERVICE_NAME=sfdc-api-server

# OpenZiti Local Bind Address
# The local address where the server will bind for OpenZiti connections
OPENZITI_LOCAL_ADDRESS=127.0.0.1:8080

# OpenZiti Tunnel Configuration
# Enable tunneler mode (alternative to embedded SDK)
OPENZITI_TUNNELER_ENABLED=false

# OpenZiti Tunneler Config Path
# Path to the tunneler configuration file
OPENZITI_TUNNELER_CONFIG_PATH=./config/tunneler.json

# Authorization timeout in seconds (default: 300 = 5 minutes)
AUTH_TIMEOUT_SECS=300

# Localhost plugin port for communication with browser tabs and desktop apps (default: 9527)
PORT=9527

# Number of retries for BLE device discovery (default: 10)
# Each retry waits 500ms, so 10 retries = 5 seconds total timeout
NO_RETRIES=10

# BLE write operation timeout in seconds (default: 5)
BLE_WRITE_TIMEOUT_SECS=5

# BLE read operation timeout in seconds (default: 5)
BLE_READ_TIMEOUT_SECS=5
